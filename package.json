{
  "name": "interview-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && SINGLE=1 vite build --outDir dist-single",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract": "node scripts/extract.mjs",
    "extract:check": "node scripts/extract.mjs --check",
    "build:single:audit": "tsc --noEmit && SINGLE=1 PACK=audit vite build --outDir dist-audit",
    "build:single:interview": "tsc --noEmit && SINGLE=1 PACK=interview vite build --outDir dist-interview",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
